<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_fuel_price_update_wizard_form" model="ir.ui.view">
            <field name="name">fuel.price.update.wizard.form</field>
            <field name="model">fuel.price.update.wizard</field>
            <field name="arch" type="xml">
                <form string="Update Fuel Price">
                    <sheet>
                        <group>
                            <field name="month"/>
                            <field name="new_fuel_price"/>
                        </group>
                        <footer>
                            <button string="Update" type="object" name="update_fuel_price" class="btn-primary"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action to Open Wizard -->
        <record id="action_fuel_price_update_wizard" model="ir.actions.act_window">
            <field name="name">Update Fuel Price</field>
            <field name="res_model">fuel.price.update.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_fuel_price_update_wizard_form"/>
            <field name="target">new</field>  <!-- Opens as a pop-up window -->
        </record>
    </data>
</odoo>