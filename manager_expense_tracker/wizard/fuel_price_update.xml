<odoo>
    <data>
        <record id="view_fuel_price_update_wizard_form" model="ir.ui.view">
            <field name="name">fuel.price.update.wizard.form</field>
            <field name="model">fuel.price.update.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Update Fuel Prices">
                    <sheet>
                        <group>
                            <field name="manager_ids" widget="many2many_tags"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="new_fuel_price"/>
                            <field name="new_consumption"/>
                            <field name="new_depreciation"/>
                        </group>
                        <footer>
                            <button string="Update" type="object" name="update_fuel_prices" class="btn-primary"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
