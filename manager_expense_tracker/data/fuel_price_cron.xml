<odoo>
    <data noupdate="1">

        <record id="ir_cron_fetch_a95_price" model="ir.cron">
            <field name="name">Fetch A-95 Price Daily</field>
            <field name="model_id" ref="model_fuel_price_history"/>
            <field name="state">code</field>
            <field name="code">model.fetch_a95_price()</field>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=8, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
