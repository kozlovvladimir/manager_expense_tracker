<odoo>
    <data>


        <record id="view_manager_finance_tree" model="ir.ui.view">
            <field name="name">manager.finance.tree</field>
            <field name="model">manager.finance</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Manager Finances">
                    <field name="manager_id"/>
                    <field name="date"/>
                    <field name="income"/>
                    <field name="expenses_other"/>
                    <field name="expenses_auto"/>
                    <field name="balance"/>
                    <field name="approved"/>
                </list>
            </field>
        </record>


        <record id="view_manager_finance_form" model="ir.ui.view">
            <field name="name">manager.finance.form</field>
            <field name="model">manager.finance</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Manager Finance">
                    <sheet>
                        <group>
                            <field name="manager_id"/>
                            <field name="date"/>
                            <field name="income"/>
                            <field name="expenses_other"/>
                            <field name="expenses_auto"/>
                            <field name="balance"/>
                            <field name="approved"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="action_manager_finance" model="ir.actions.act_window">
            <field name="name">Manager Finances</field>
            <field name="res_model">manager.finance</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
