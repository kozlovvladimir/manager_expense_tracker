<odoo>
    <data>

        <!-- Form View -->
        <record id="view_manager_finance_form" model="ir.ui.view">
            <field name="name">manager.finance.form</field>
            <field name="model">manager.finance</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Manager Finance">
                    <sheet>
                        <group>
                            <field name="manager_id"/>
                            <field name="date"/>
                            <field name="initial_balance" readonly="1"/>
                            <field name="income"/>
                            <field name="expenses_other"/>
                            <field name="expenses_auto"/>
                            <field name="balance"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_manager_finance_list" model="ir.ui.view">
            <field name="name">manager.finance.list</field>
            <field name="model">manager.finance</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Manager Finances">
                    <field name="manager_id"/>
                    <field name="date"/>
                    <field name="initial_balance" readonly="1"/>
                    <field name="income"/>
                    <field name="expenses_other"/>
                    <field name="expenses_auto"/>
                    <field name="balance"/>
                </list>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="view_manager_finance_pivot" model="ir.ui.view">
            <field name="name">manager.finance.pivot</field>
            <field name="model">manager.finance</field>
            <field name="type">pivot</field>
            <field name="arch" type="xml">
                <pivot string="Finance Analysis">
                    <field name="manager_id" type="row"/>
                    <field name="date" type="col"/>
                    <field name="income" type="measure"/>
                    <field name="expenses_other" type="measure"/>
                    <field name="expenses_auto" type="measure"/>
                    <field name="balance" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Graph View -->
        <record id="view_manager_finance_graph" model="ir.ui.view">
            <field name="name">manager.finance.graph</field>
            <field name="model">manager.finance</field>
            <field name="type">graph</field>
            <field name="arch" type="xml">
                <graph string="Finance Graph" type="bar">
                    <field name="date" type="row"/>
                    <field name="income" type="measure"/>
                    <field name="expenses_other" type="measure"/>
                    <field name="expenses_auto" type="measure"/>
                    <field name="balance" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_manager_finance_kanban" model="ir.ui.view">
            <field name="name">manager.finance.kanban</field>
            <field name="model">manager.finance</field>
            <field name="type">kanban</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_example">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <strong><field name="date"/></strong>
                                <div><strong>Manager:</strong> <field name="manager_id"/></div>
                                <div><strong>Income:</strong> <field name="income"/></div>
                                <div><strong>Total:</strong> <field name="balance"/></div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action -->
        <record id="action_manager_finance" model="ir.actions.act_window">
            <field name="name">Manager Finance</field>
            <field name="res_model">manager.finance</field>
            <field name="view_mode">list,form,pivot,graph,kanban</field>
        </record>

    </data>
</odoo>
