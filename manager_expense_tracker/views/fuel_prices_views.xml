<odoo>
    <data>

        <!-- Form View -->
        <record id="view_fuel_prices_form" model="ir.ui.view">
            <field name="name">fuel.prices.form</field>
            <field name="model">fuel.prices</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Fuel Prices">
                    <sheet>
                        <group>
                            <field name="manager_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="fuel_price"/>
                            <field name="consumption"/>
                            <field name="depreciation"/>
                        </group>
                        <footer>
                            <button name="open_update_wizard" string="Update Price" type="object" class="oe_highlight"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_fuel_prices_list" model="ir.ui.view">
            <field name="name">fuel.prices.list</field>
            <field name="model">fuel.prices</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Fuel Prices">
                    <field name="manager_id"/>
                    <field name="date"/>
                    <field name="fuel_price"/>
                    <field name="consumption"/>
                    <field name="depreciation"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_fuel_prices_search" model="ir.ui.view">
            <field name="name">fuel.prices.search</field>
            <field name="model">fuel.prices</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search Fuel Prices">
                    <field name="manager_id"/>
                    <field name="date"/>
                    <field name="fuel_price"/>
                    <field name="consumption"/>
                    <field name="depreciation"/>
                </search>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="view_fuel_prices_pivot" model="ir.ui.view">
            <field name="name">fuel.prices.pivot</field>
            <field name="model">fuel.prices</field>
            <field name="type">pivot</field>
            <field name="arch" type="xml">
                <pivot string="Fuel Prices Analysis">
                    <field name="manager_id" type="row"/>
                    <field name="date" type="col"/>
                    <field name="fuel_price" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Graph View -->
        <record id="view_fuel_prices_graph" model="ir.ui.view">
            <field name="name">fuel.prices.graph</field>
            <field name="model">fuel.prices</field>
            <field name="type">graph</field>
            <field name="arch" type="xml">
                <graph string="Fuel Prices Trends" type="line">
                    <field name="date" type="row"/>
                    <field name="fuel_price" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Action -->
        <record id="action_fuel_prices" model="ir.actions.act_window">
            <field name="name">Fuel Prices</field>
            <field name="res_model">fuel.prices</field>
            <field name="view_mode">list,form,search,pivot,graph</field>
        </record>

        <!-- Mass Action to Update Fuel Prices (calls Python method) -->
        <record id="action_fuel_prices_mass_update" model="ir.actions.server">
            <field name="name">Mass Update Fuel Prices</field>
            <field name="model_id" ref="model_fuel_prices"/>
            <field name="binding_model_id" ref="model_fuel_prices"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">
                action = record.open_mass_update_wizard()
            </field>
        </record>


    </data>
</odoo>
