<odoo>
    <data>

        <!-- List View (бывший Tree View) -->
        <record id="view_fuel_prices_list" model="ir.ui.view">
            <field name="name">fuel.prices.list</field>
            <field name="model">fuel.prices</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Fuel Prices">
                    <field name="month"/>
                    <field name="fuel_price"/>
                    <field name="consumption"/>
                    <field name="depreciation"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Form View for Fuel Prices -->
        <record id="view_fuel_prices_form" model="ir.ui.view">
            <field name="name">fuel.prices.form</field>
            <field name="model">fuel.prices</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Fuel Prices">
                    <sheet>
                        <group>
                            <group>
                                <field name="month"/>
                                <field name="fuel_price"/>
                            </group>
                            <group>
                                <field name="consumption"/>
                                <field name="depreciation"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Fuel Prices -->
        <record id="action_fuel_prices" model="ir.actions.act_window">
            <field name="name">Fuel Prices</field>
            <field name="res_model">fuel.prices</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new fuel price entry for a specific month.
                </p>
            </field>
        </record>

    </data>
</odoo>
